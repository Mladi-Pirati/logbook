# Keycloak (OIDC) — this app is registered as the "logbook" client
KEYCLOAK_ISSUER=https://auth.piratskastranka.si/auth/realms/mladipirati
KEYCLOAK_CLIENT_ID=logbook
KEYCLOAK_CLIENT_SECRET=

# Helm API — provides user data and validates application access
HELM_API_URL=http://localhost:3000

# NextAuth (Auth.js v5)
# Generate a secret with: bunx auth secret
AUTH_SECRET=
# This app's own public URL (use the dev port logbook runs on)
AUTH_URL=http://localhost:3002


# Discord integration (piratosan-discord bot)
# Inbound: the bot authenticates to /api/integrations/discord/* with this
# secret (it stores the same value as LOGBOOK_API_SECRET).
DISCORD_INTEGRATION_SECRET=
# Outbound: logbook posts/edits ticket embeds through the bot's HTTP API.
# DISCORD_BOT_SECRET must equal the bot's API_BEARER_SECRET.
# Leave both empty to disable Discord notifications entirely.
DISCORD_BOT_URL=http://localhost:3100
DISCORD_BOT_SECRET=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5439/logbook

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logbook

# S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
S3_ENDPOINT=https://s3.mladipirati.si
S3_BUCKET=logbook